# Puerto HTTP en el que escucha la aplicacion dentro del contenedor
PORT=8080

# Conexion con pooling de Neon (usada por la aplicacion / HikariCP en tiempo de ejecucion).
# En Neon el hostname incluye "-pooler".
DB_URL=jdbc:postgresql://ep-ejemplo-123456-pooler.us-east-2.aws.neon.tech/tienda_armas_gta?sslmode=require

# Conexion directa de Neon (usada por Flyway para ejecutar migraciones y bloqueos DDL).
# En Neon el hostname NO incluye "-pooler".
DB_DIRECT_URL=jdbc:postgresql://ep-ejemplo-123456.us-east-2.aws.neon.tech/tienda_armas_gta?sslmode=require

# Credenciales de acceso a Neon (completar en .env local, nunca subir a Git ni copiar a la imagen)
DB_USERNAME=usuario_neon_ejemplo
DB_PASSWORD=password_neon_ejemplo
